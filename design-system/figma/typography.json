{
  "$collection": "5.Typography",
  "fontFamily": {
    "base": { "$value": "Geist", "$type": "fontFamily" }
  },
  "fontSize": {
    "100": { "$value": 10, "$type": "dimension" },
    "200": { "$value": 11, "$type": "dimension" },
    "300": { "$value": 12, "$type": "dimension" },
    "400": { "$value": 13, "$type": "dimension" },
    "500": { "$value": 14, "$type": "dimension" },
    "600": { "$value": 16, "$type": "dimension" },
    "700": { "$value": 18, "$type": "dimension" },
    "800": { "$value": 20, "$type": "dimension" },
    "900": { "$value": 24, "$type": "dimension" },
    "1000": { "$value": 28, "$type": "dimension" },
    "1100": { "$value": 32, "$type": "dimension" },
    "1200": { "$value": 40, "$type": "dimension" },
    "1300": { "$value": 44, "$type": "dimension" },
    "1400": { "$value": 52, "$type": "dimension" },
    "1500": { "$value": 56, "$type": "dimension" },
    "1600": { "$value": 64, "$type": "dimension" },
    "1700": { "$value": 72, "$type": "dimension" }
  },
  "lineHeight": {
    "100": { "$value": 14, "$type": "dimension" },
    "200": { "$value": 16, "$type": "dimension" },
    "300": { "$value": 18, "$type": "dimension" },
    "400": { "$value": 20, "$type": "dimension" },
    "500": { "$value": 24, "$type": "dimension" },
    "600": { "$value": 28, "$type": "dimension" },
    "700": { "$value": 32, "$type": "dimension" },
    "800": { "$value": 36, "$type": "dimension" },
    "900": { "$value": 40, "$type": "dimension" },
    "1000": { "$value": 44, "$type": "dimension" },
    "1100": { "$value": 52, "$type": "dimension" },
    "1200": { "$value": 56, "$type": "dimension" },
    "1300": { "$value": 64, "$type": "dimension" },
    "1400": { "$value": 72, "$type": "dimension" },
    "1500": { "$value": 80, "$type": "dimension" }
  },
  "fontWeight": {
    "Regular":  { "$value": 400, "$type": "fontWeight" },
    "Medium":   { "$value": 500, "$type": "fontWeight" },
    "Semibold": { "$value": 600, "$type": "fontWeight" },
    "Bold":     { "$value": 700, "$type": "fontWeight" }
  },
  "letterSpacing": {
    "100": { "$value": -2,   "$type": "dimension" },
    "200": { "$value": -1.5, "$type": "dimension" },
    "300": { "$value": -1,   "$type": "dimension" },
    "400": { "$value": -0.5, "$type": "dimension" },
    "500": { "$value": 0,    "$type": "dimension" },
    "600": { "$value": 0.5,  "$type": "dimension" },
    "700": { "$value": 1,    "$type": "dimension" },
    "800": { "$value": 2,    "$type": "dimension" }
  }
}
